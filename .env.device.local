# Physical Android device — Wi-Fi / LAN development build
#
# This file is gitignored (*.local pattern in .gitignore).
# Never commit it — the IP changes whenever you switch networks.
#
# How to find your computer's LAN IP (Windows):
#   1. Open PowerShell and run: ipconfig
#   2. Look for "IPv4 Address" under your Wi-Fi adapter
#   3. Replace 192.168.x.x below with that address
#
# Your phone must be on the SAME Wi-Fi network as this computer.
#
# After changing this value:
#   npm run android:device
#     (builds with this URL baked in, syncs to Android, opens Android Studio)
#
# Also open Windows Firewall port 8001 once (run PowerShell as Admin):
#   New-NetFirewallRule -DisplayName "FarmIQ Dev Backend" -Direction Inbound -Protocol TCP -LocalPort 8001 -Action Allow
#
VITE_API_BASE_URL=http://192.168.x.x:8001

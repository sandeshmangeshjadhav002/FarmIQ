# ─────────────────────────────────────────────────────────────────────────
# FarmIQ backend environment configuration
# Copy to ".env" and fill in. This file is safe to commit (no secrets).
#   copy .env.example .env   (Windows)
# ─────────────────────────────────────────────────────────────────────────

# Supabase project — find these in your Supabase dashboard:
#   Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
# Service-role key — SERVER SIDE ONLY. Never expose to the frontend.
# Bypasses Row Level Security; the backend enforces explicit ownership checks.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
# Optional: used only for local JWT verification fallback.
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins.
# Vite dev server + Capacitor WebView origins on Android.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# ML assets — paths to the existing FarmIQ-rag preprocessed artifacts.
# Defaults point to ../FarmIQ-rag (relative to this backend/ folder).
FARMIQ_ML_PROCESSED_PATH=../FarmIQ-rag/datasets/processed
FARMIQ_ML_MODELS_PATH=../FarmIQ-rag/models
# Raw (unscaled) datasets — source of the averages used to fill inputs the
# farmer did not provide. Never point this at datasets/processed.
FARMIQ_ML_RAW_PATH=../FarmIQ-rag/datasets/raw

# Speech-to-text — server-side transcription for POST /api/voice/transcribe.
# Used when the browser has no Web Speech API (Firefox/Safari) or when Chrome
# reports "network error during speech recognition". Any OpenAI-compatible
# /audio/transcriptions provider works; Groq Whisper is the free default.
# Get a key at https://console.groq.com/keys — leave blank to disable the endpoint.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# Text-to-speech — server-side synthesis for POST /api/voice/speak.
# Used when the device has no voice for the answer's language (typical for
# Marathi on Windows and stock Android), which would otherwise stay silent.
# Free Microsoft Edge neural voices via the edge-tts package — no API key
# needed, but the server requires outbound internet access.
TTS_ENABLED=true
TTS_VOICE_MR=mr-IN-AarohiNeural
TTS_VOICE_EN=en-IN-NeerjaNeural

# Optional shared secret for ESP32 sensor ingestion (POST /api/sensor-readings/ingest).
# If empty, ingestion requires a valid user access token instead.
SENSOR_INGEST_TOKEN=

# Weather auto-fill (GET /api/weather/current). Open-Meteo is key-less, so
# there is NO API key or secret to configure. Set WEATHER_ENABLED=false to turn
# the endpoint off (it then returns 503 and the prediction form stays usable
# with manual entry). WEATHER_HISTORY_DAYS controls how many past days of
# rainfall are accumulated for the rainfall auto-fill.
WEATHER_ENABLED=true
WEATHER_HISTORY_DAYS=30
# Override only if you proxy the provider:
# WEATHER_BASE_URL=https://api.open-meteo.com/v1
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

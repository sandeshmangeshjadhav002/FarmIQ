# ─────────────────────────────────────────────────────────────────────
# FarmIQ backend (FastAPI + Supabase)
# ─────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/

# ── Virtual environment ──────────────────────────────────────────────
.venv/
venv/
env/

# ── Testing / lint caches ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Logs ─────────────────────────────────────────────────────────────
logs/
*.log

# ── ML artefacts (models are loaded from FarmIQ-rag/models) ──────────
models/
*.joblib
*.pkl

# ── Environment / secrets (never commit real credentials) ────────────
.env
.env.*
!.env.example

# FarmIQ-RAG environment configuration.
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
#
# NEVER commit your real .env file. It is git-ignored by default.

# ───────────────────────────────────────────────────────────────────────
# LLM provider (answer generation)
# ───────────────────────────────────────────────────────────────────────
# Required to generate answers. Retrieval still works without it, but the
# assistant will only return raw retrieved passages.
LLM_API_KEY=

# Model name for the LLM. Examples:
#   OpenAI:     gpt-4o-mini
#   Together:   meta-llama/Llama-3-8b-chat-hf
#   Groq:       llama-3.1-8b-instant
LLM_MODEL=gpt-4o-mini

# Optional: base URL for OpenAI-compatible providers.
# Leave blank for OpenAI itself.
#   Together:   https://api.together.xyz/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Local vLLM:  http://localhost:8000/v1
LLM_BASE_URL=

# Provider selector (default: openai). Use "openai" for any OpenAI-compatible API.
LLM_PROVIDER=openai

# Generation parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_REQUEST_TIMEOUT=60

# ───────────────────────────────────────────────────────────────────────
# Embeddings (used for BOTH ingestion and retrieval — keep them identical)
# ───────────────────────────────────────────────────────────────────────
# Multilingual MiniLM supports English + Marathi + other Indian languages.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional: override the HuggingFace model cache directory.
# HF_HOME=

# ───────────────────────────────────────────────────────────────────────
# Vector store
# ───────────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
COLLECTION_NAME=farmiq_agri_docs
# Distance metric: cosine (recommended), l2, or ip
CHROMA_DISTANCE_METRIC=cosine

# ───────────────────────────────────────────────────────────────────────
# Document directories
# ───────────────────────────────────────────────────────────────────────
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# ───────────────────────────────────────────────────────────────────────
# Chunking
# ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ───────────────────────────────────────────────────────────────────────
# Retrieval
# ───────────────────────────────────────────────────────────────────────
TOP_K=5
# Minimum cosine similarity (0..1) for a chunk to be considered relevant.
RELEVANCE_THRESHOLD=0.30

# ───────────────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

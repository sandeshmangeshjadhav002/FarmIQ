# Production build configuration — loaded automatically by `npm run build`
# (Vite mode "production" loads .env.production and .env.production.local)
#
# This file is safe to commit because it contains no secrets —
# only a public HTTPS URL. Never put API keys or tokens here.
#
# The backend is deployed at:
#   https://farmiq-api-hpss.onrender.com
#
# To trigger a production build locally:
#   npm run build
#
# To build the production Android APK:
#   npm run build
#   cap sync android
#   # Then open Android Studio → Build → Generate Signed Bundle/APK → Release
#
VITE_API_BASE_URL=https://farmiq-api-hpss.onrender.com
